# ======== SERVER-ONLY (set in Vercel -> Settings -> Environment Variables; never prefix with VITE_) ========
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio). Put the CURRENT model id from AI Studio's model list.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Grok fallback (xAI). If XAI_API_KEY is empty, the fallback is simply disabled.
XAI_API_KEY=
XAI_MODEL=grok-4

# Shared secret between the Cloudflare Worker and /api/agent-sweep
CRON_SECRET=
SWEEP_MIN_AGE_MIN=15
SWEEP_INTERVAL_MIN=60

# Guardrails
MAX_PER_PERSON=500
MAX_SPLIT_TOTAL=2000

# ======== BROWSER-SAFE (public by design; used at build time) ========
VITE_PAYPAL_CLIENT_ID=
